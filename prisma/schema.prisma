
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-client"

}

datasource db {
  provider = "postgresql"


}

model User {
  id String @id @default(nanoid())
  email String @unique
  name String
  password String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}